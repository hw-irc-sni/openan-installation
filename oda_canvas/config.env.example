# Copy to config.env (untracked, gitignored) and set the values. Never commit config.env.
# Must equal the admin password of the Keycloak bundled with charts/canvas-oda
# (chart default; changing it also requires overriding the chart's Keycloak and identity-operator values).
KC_ADMIN_PASSWORD=CHANGE_ME
# Password of the portal login user (PORTAL_USER in config.mk).
PORTAL_USER_PASSWORD=CHANGE_ME
# Secret of the canvas-portal-admin service-account client.
PORTAL_ADMIN_CLIENT_SECRET=CHANGE_ME
# Grafana "admin" password.
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
# Password of the initial Langfuse user (LANGFUSE_INIT_USER_EMAIL in config.mk); at least 8 characters.
# The other Langfuse secrets (salt, encryption key, DB passwords) are generated into a cluster Secret.
LANGFUSE_INIT_USER_PASSWORD=CHANGE_ME
